{
    "bin": {"PikaTimer": "jdeploy-bundle/jdeploy.js"},
    "author": "John Garner",
    "main": "index.js",
    "preferGlobal": true,
    "repository": {"url": "https://github.com/PikaTimer/PikaTimer"},
    "version": "2.0_alpha1",
    "jdeploy": {
        "jdk": true,
        "args": [
            "-X[mac]dock:name=\"PikaTimer\"",
            "--add-opens javafx.graphics/javafx.scene=org.controlsfx.controls",
            "--add-opens javafx.graphics/javafx.scene=ALL-UNNAMED"
        ],
        "fallbackToUniversal": false,
        "generateLegacyBundles": false,
        "publishTargets": [],
        "javaVersion": "25",
        "jar": "target/PikaTimer-2.0-uber.jar",
        "javafx": true,
        "title": "PikaTimer",
        "platformBundlesEnabled": false,
        "downloadPage": {"platforms": ["default"]}
    },
    "dependencies": {
        "command-exists-promise": "^2.0.2",
        "node-fetch": "2.6.7",
        "tar": "^4.4.8",
        "yauzl": "^2.10.0",
        "shelljs": "^0.8.4"
    },
    "license": "GPL-3.0",
    "name": "PikaTimer",
    "files": ["jdeploy-bundle"],
    "scripts": {"test": "echo \"Error: no test specified\" && exit 1"}
}