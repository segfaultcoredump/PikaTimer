<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootVBox" maxWidth="1.7976931348623157E308" spacing="4.0" stylesheets="@PikaReaderDirect.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pikatimer.timing.reader.SelectTimerReaderController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <Label text="Select Timer Link">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Pane maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel" text="Accepting Reads:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Circle fx:id="statusCircle" fill="#949494" radius="8.0" stroke="BLACK" strokeType="INSIDE" />
         </children>
         <padding>
            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <ComboBox fx:id="urlComboBox" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            <Button fx:id="copyButton" minWidth="-Infinity" mnemonicParsing="false" text="Copy" />
         </children>
         <padding>
            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
         </padding>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <ImageView fx:id="qrImageView" fitHeight="160.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" smooth="false" />
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="helpLabel" maxWidth="1.7976931348623157E308" wrapText="true" text="Scan the code with a phone or tablet on the same network. Each device has to accept the security warning the first time it connects." />
                  <Label fx:id="warningLabel" managed="false" maxWidth="1.7976931348623157E308" visible="false" wrapText="true" />
                  <CheckBox fx:id="knownBibsCheckBox" mnemonicParsing="false" text="Only read registered bibs" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Ignore a repeat of the same bib for" />
                        <Spinner fx:id="repeatSpinner" editable="true" prefWidth="80.0" />
                        <Label text="seconds" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Button fx:id="newLinkButton" minWidth="-Infinity" mnemonicParsing="false" text="New Link..." />
                        <Pane maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="enableButton" minWidth="-Infinity" mnemonicParsing="false" text="Stop Accepting Reads" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <Label fx:id="readCountLabel" text="Reads: 0" />
            <Pane maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            <Label minWidth="-Infinity" text="Last Read: " />
            <Label fx:id="lastReadLabel" text="&lt;No Reads&gt;" />
         </children>
         <padding>
            <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
         </padding>
      </HBox>
      <TableView fx:id="deviceTableView" minHeight="80.0" prefHeight="120.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="deviceNameColumn" prefWidth="120.0" text="Device" />
            <TableColumn fx:id="deviceAddressColumn" prefWidth="100.0" text="Address" />
            <TableColumn fx:id="deviceContactColumn" prefWidth="80.0" text="Last Contact" />
            <TableColumn fx:id="deviceReadsColumn" prefWidth="50.0" text="Reads" />
            <TableColumn fx:id="devicePendingColumn" prefWidth="55.0" text="Queued" />
            <TableColumn fx:id="deviceClockColumn" prefWidth="110.0" text="Clock" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
